# Copy to .env, then add your own key. Never commit .env.
GEMINI_API_KEY=
STORYROOM_MODEL=gemini-3.8-flash
STORYROOM_EMBED_MODEL=gemini-embedding-2
# Conservative USD per million tokens. Confirm against provider billing before enabling.
STORYROOM_INPUT_RATE=1.50
STORYROOM_OUTPUT_RATE=9.00
STORYROOM_EMBED_RATE=0.20
# Set true only after checking the rates for your chosen model.
STORYROOM_PRICING_CONFIRMED=false
STORYROOM_SPEND_LIMIT=45
